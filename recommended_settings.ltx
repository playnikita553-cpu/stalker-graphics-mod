; ============================================================================
; STALKER: Shadow of Chernobyl — Realistic Graphics Mod
; Recommended Renderer Settings
;
; Copy these settings to your user.ltx file:
;   %USERPROFILE%\Documents\stalker-shoc\user.ltx
;
; Or apply them in-game via console (~)
; ============================================================================

; --- Renderer ---
renderer renderer_r2

; --- Anti-Aliasing ---
r2_aa off
r2_aa_break 0.000000,0.000000,0.000000
r2_aa_kernel 0.7
r2_aa_weight 1.000000,0.067500,0.000000

; --- Bloom ---
r2_ls_bloom_fast on
r2_ls_bloom_kernel_b 0.65
r2_ls_bloom_kernel_g 3.0
r2_ls_bloom_kernel_scale 0.8
r2_ls_bloom_speed 40.0
r2_ls_bloom_threshold 0.2

; --- Tone Mapping ---
r2_tonemap on
r2_tonemap_adaptation 2.5
r2_tonemap_amount 0.6
r2_tonemap_lowlum 0.45
r2_tonemap_middlegray 0.62

; --- Sun & Lighting ---
r2_sun on
r2_sun_details on
r2_sun_focus on
r2_sun_lumscale 1.0
r2_sun_lumscale_amb 1.0
r2_sun_lumscale_hemi 1.0
r2_sun_near 45.0
r2_sun_near_border 1.0
r2_sun_tsm off
r2_sun_tsm_bias -0.05
r2_sun_tsm_proj 0.18

; --- Shadow Quality ---
r2_ls_depth_bias -0.0001
r2_ls_depth_scale 1.00001
r2_sun_depth_far_bias 0.0
r2_sun_depth_far_scale 1.0
r2_sun_depth_near_bias -0.00012
r2_sun_depth_near_scale 1.00001
r2_ls_dsm_kernel 0.8
r2_ls_psm_kernel 0.8
r2_ls_squality 1.0
r2_ls_ssm_kernel 1.0

; --- Gloss & Materials ---
r2_gloss_factor 3.0

; --- Motion Blur ---
r2_mblur 0.03

; --- Parallax ---
r2_parallax_h 0.5

; --- Global Illumination ---
r2_gi off
r2_gi_clip 0.001
r2_gi_depth 1
r2_gi_photons 16
r2_gi_refl 0.7

; --- Emission & LOD ---
r2em 0.0
r2_slight_fade 1.0
r2_ssa_lod_a 64.0
r2_ssa_lod_b 48.0
r2_tf_mipbias 0.0
r2_zfill off
r2_zfill_depth 0.1
r2_wait_sleep 0

; --- Detail & Quality ---
r__detail_density 0.3
r__geometry_lod 1.0
r__supersample 2
r__tf_aniso 16
